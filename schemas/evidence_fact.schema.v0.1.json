{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://builder.local/schemas/evidence_fact.schema.v0.1.json",
  "title": "M9 local candidate evidence fact",
  "description": "An explicitly classified, locally recorded candidate fact. evidence_type describes how the claim was formed; verification_status remains unverified in v0.1. It is not a Core input or legal finding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fact_id", "case_id", "subject", "field", "value", "unit", "evidence_type", "source", "observed_at", "valid_from", "valid_until", "confidence", "recorded_at", "model_version", "parameter_version", "supporting_fact_ids", "evidence_snapshot_hash", "verification_status"],
  "properties": {
    "schema_version": {"const": "evidence-fact-0.1"},
    "fact_id": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,80}$"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["case", "stakeholder"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "field": {"type": "string", "minLength": 1, "maxLength": 80},
    "value": {"oneOf": [
      {"type": "string", "minLength": 1, "maxLength": 500},
      {"type": "number"},
      {"type": "boolean"}
    ]},
    "unit": {"type": ["string", "null"], "maxLength": 40},
    "evidence_type": {"enum": ["observed", "inferred", "assumed", "calibrated"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "version"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": ["string", "null"], "maxLength": 80}
      }
    },
    "observed_at": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
    "valid_from": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
    "valid_until": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
    "confidence": {"enum": ["unknown", "low", "medium", "high"]},
    "recorded_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "model_version": {"type": ["string", "null"], "maxLength": 100},
    "parameter_version": {"type": ["string", "null"], "maxLength": 100},
    "supporting_fact_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,80}$"}},
    "evidence_snapshot_hash": {"anyOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
    "verification_status": {"const": "unverified"}
  },
  "allOf": [
    {"if": {"properties": {"evidence_type": {"const": "observed"}}}, "then": {"properties": {"observed_at": {"type": "string", "format": "date"}}}},
    {"if": {"properties": {"evidence_type": {"enum": ["observed", "assumed"]}}}, "then": {"properties": {"model_version": {"type": "null"}, "parameter_version": {"type": "null"}, "supporting_fact_ids": {"maxItems": 0}, "evidence_snapshot_hash": {"type": "null"}}}},
    {"if": {"properties": {"evidence_type": {"const": "assumed"}}}, "then": {"properties": {"observed_at": {"type": "null"}}}},
    {"if": {"properties": {"evidence_type": {"const": "inferred"}}}, "then": {"properties": {"model_version": {"type": "string", "minLength": 1}, "supporting_fact_ids": {"minItems": 1}}}},
    {"if": {"properties": {"evidence_type": {"const": "inferred"}}}, "then": {"properties": {"parameter_version": {"type": "null"}, "evidence_snapshot_hash": {"type": "null"}}}},
    {"if": {"properties": {"evidence_type": {"const": "calibrated"}}}, "then": {"properties": {"model_version": {"type": "string", "minLength": 1}, "parameter_version": {"type": "string", "minLength": 1}, "supporting_fact_ids": {"minItems": 1}, "evidence_snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}
  ]
}
